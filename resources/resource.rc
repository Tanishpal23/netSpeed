#include "resource.h"
#include <windows.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "NetSpeed Open Source"
            VALUE "FileDescription",  "NetSpeed Real-Time Internet Speed Monitor"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "NetSpeed"
            VALUE "LegalCopyright",   "Copyright (C) 2026. MIT License."
            VALUE "OriginalFilename", "NetSpeed.exe"
            VALUE "ProductName",      "NetSpeed"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
